<launch>
      <arg name="gui" default="true" />
    <arg name="paused" default="false" />
    <arg name="use_sim_time" default="true" />
    <arg name="enable_trajectory" default="false" />
    <arg name="trajectory_loop" default="true" />

    <!-- gazebo_ros publishes /clock through its Gazebo API plugin.  Keep the
         parameter explicit so every sensor, odometry message, and TF consumer
         follows the same simulation time base. -->
    <param name="/use_sim_time" value="$(arg use_sim_time)" />

    <!-- Load the existing wheeled car. -->
    <param name="robot_description"
          command="$(find xacro)/xacro $(find urdf02_gazebo)/urdf/car.xacro" />

    <!-- Load the drone as a second, independent robot. -->
    <param name="drone_description"
           command="$(find xacro)/xacro $(find urdf02_gazebo)/urdf/drone.urdf.xacro" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
            <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="world_name" value="$(find urdf02_gazebo)/worlds/box_house.world" />
    </include>

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_car"
          args="-urdf -model car -param robot_description -x 0 -y 0 -z 0.12" />

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_drone"
          args="-urdf -model drone -param drone_description -x 1.5 -y 0 -z 1.5" />

    <group ns="drone">
        <param name="robot_description"
               command="$(find xacro)/xacro $(find urdf02_gazebo)/urdf/drone.urdf.xacro" />
        <node pkg="robot_state_publisher" type="robot_state_publisher"
              name="robot_state_publisher" output="screen">
            <remap from="tf" to="/tf" />
            <remap from="tf_static" to="/tf_static" />
            <param name="publish_frequency" value="30.0" />
            <param name="use_tf_static" value="true" />
        </node>
    </group>

    <node pkg="urdf02_gazebo" type="drone_odom_tf.py" name="drone_odom_tf" output="screen">
        <param name="odom_topic" value="/robot1/odom_raw" />
        <param name="odom_output_topic" value="/robot1/odom" />
        <param name="odom_frame" value="robot1/odom" />
        <param name="base_frame" value="robot1/base_link" />
        <param name="mode" value="auto" />
    </node>

    <!-- Consume /robot1/cmd_vel and apply 3D translation/yaw through Gazebo. -->
    <node pkg="urdf02_gazebo" type="drone_cmd_vel_controller.py"
          name="drone_cmd_vel_controller" output="screen">
        <param name="model_name" value="drone" />
        <param name="cmd_vel_topic" value="/robot1/cmd_vel" />
        <param name="command_timeout" value="0.5" />
        <param name="update_rate" value="50.0" />
    </node>

    <group if="$(arg enable_trajectory)">
        <node pkg="urdf02_gazebo" type="drone_trajectory.py"
              name="drone_trajectory" output="screen">
            <param name="cmd_vel_topic" value="/robot1/cmd_vel" />
            <param name="loop" value="$(arg trajectory_loop)" />
            <param name="start_delay" value="2.0" />
        </node>
    </group>

    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_robot1_odom"
          args="0 0 0 0 0 0 world robot1/odom" />

    <!-- Ground truth is for evaluation only and must not feed SlideSLAM. -->
    <node pkg="urdf02_gazebo" type="ground_truth_odom.py" name="drone_ground_truth_odom"
          output="screen">
        <param name="model_name" value="drone" />
        <param name="world_frame" value="world" />
        <param name="odom_frame" value="robot1/odom" />
        <param name="base_frame" value="robot1/base_link" />
        <param name="ground_truth_topic" value="/robot1/ground_truth/odom" />
        <param name="publish_odom_tf" value="false" />
    </node>

    <!-- Bidirectional car/drone telemetry communication. -->
    <node pkg="urdf02_gazebo" type="car_drone_communication.py"
          name="car_drone_communication" output="screen" />

    <!-- Publish the drone 3D lidar using SlideSLAM's PointCloud2 interface. -->
    <node pkg="urdf02_gazebo" type="drone_pointcloud2_bridge.py"
          name="drone_pointcloud2_bridge" output="screen" />
</launch>
