<launch>
      <arg name="gui" default="true" />

    <!-- Load the existing wheeled car. -->
    <param name="robot_description"
          command="$(find xacro)/xacro $(find urdf02_gazebo)/urdf/car.xacro" />

    <!-- Load the drone as a second, independent robot. -->
    <param name="drone_description"
           command="$(find xacro)/xacro $(find urdf02_gazebo)/urdf/drone.urdf.xacro" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
            <arg name="gui" value="$(arg gui)" />
        <arg name="world_name" value="$(find urdf02_gazebo)/worlds/box_house.world" />
    </include>

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_car"
          args="-urdf -model car -param robot_description -x 0 -y 0 -z 0.12" />

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_drone"
          args="-urdf -model drone -param drone_description -x 1.5 -y 0 -z 1.5" />

    <!-- Bidirectional car/drone telemetry communication. -->
    <node pkg="urdf02_gazebo" type="car_drone_communication.py"
          name="car_drone_communication" output="screen" />

    <!-- Publish the drone 3D lidar using SlideSLAM's PointCloud2 interface. -->
    <node pkg="urdf02_gazebo" type="drone_pointcloud2_bridge.py"
          name="drone_pointcloud2_bridge" output="screen" />
</launch>
