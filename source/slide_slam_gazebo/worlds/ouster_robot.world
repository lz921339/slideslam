<?xml version="1.0"?>
<sdf version="1.6">
  <world name="slide_slam_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="mobile_base">
      <pose>0 0 0.1 0 0 0</pose>
      <link name="base_link">
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.2</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.2</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="ouster_sensor">
      <pose>0 0 0.35 0 0 0</pose>
      <link name="sensor_link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0 0.5 1 1</ambient></material>
        </visual>
      </link>
      <plugin name="laser_plugin" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>os_sensor</frameName>
        <updateRate>10</updateRate>
      </plugin>
    </model>
  </world>
</sdf>
